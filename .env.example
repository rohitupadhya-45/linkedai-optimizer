# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# AI Provider API Key (OpenRouter or OpenAI)
# OpenRouter keys begin with "sk-or-v1-". The server auto-detects them and routes to https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Or explicitly:
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Default AI Model (for OpenRouter e.g. openai/gpt-4o-mini, google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku)
AI_MODEL=openai/gpt-4o-mini

# LinkedIn API OAuth 2.0 Credentials
# Get your client ID and Secret at: https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/linkedin/callback
